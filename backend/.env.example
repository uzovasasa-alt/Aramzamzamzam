# --- База данных (PostgreSQL 14+ с расширением PostGIS) ---
DATABASE_URL=postgres://agro:agro@localhost:5432/agro

# --- JWT: обязательно замените на длинные случайные строки в продакшене ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=1h
# Водитель может быть без связи несколько дней — refresh живёт долго
JWT_REFRESH_TTL=60d

# --- Хранилище фото: disk (папка на диске, по умолчанию) или s3 ---
STORAGE_DRIVER=disk
DISK_STORAGE_PATH=./uploads
# Для STORAGE_DRIVER=s3 — любое S3-совместимое хранилище, например Yandex Object Storage:
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_PUBLIC_ENDPOINT=https://storage.yandexcloud.net   # адрес, по которому браузер открывает фото
# S3_REGION=ru-central1
# S3_BUCKET=agro-photos
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_FORCE_PATH_STYLE=true

# --- Шлюзы трекеров (этап 2) ---
TELTONIKA_TCP_PORT=5027
WIALON_TCP_PORT=20332
# true — отвергать пакеты Wialon IPS 2.0 с неверной контрольной суммой
WIALON_STRICT_CRC=false
# Ключ для POST /api/telemetry/ingest (свои устройства на ESP32, ретрансляция из других систем)
TELEMETRY_HTTP_KEY=change-me-telemetry

# --- Уведомления модератору в Telegram (необязательно) ---
# Создайте бота у @BotFather, chat id хозяйства задаётся в настройках хозяйства в веб-панели
TELEGRAM_BOT_TOKEN=

PORT=3000
CORS_ORIGIN=http://localhost:5173
